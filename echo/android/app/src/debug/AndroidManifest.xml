<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".DebugEchoApp"
        tools:replace="android:name">
        <!-- ECP adb 入口：仅 debug 源集注册；release manifest 物理不存在。
             exported 必须为 true（广播由 shell uid 经 am 发起）；
             不挂 permission——adb shell（USB 调试）即受信边界。 -->
        <receiver
            android:name=".DebugControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.everse.echo.CTRL"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
